# ===============================================
# AI Study Assistant - Production Environment Config Template
# Copy this file to .env and fill in your actual API keys
# ===============================================

# LLM Provider selection: "groq" or "gemini"
LLM_PROVIDER=groq

# Generic LLM API Key (works for both Groq and Gemini based on the provider chosen above)
LLM_API_KEY=your_api_key_here

# Optional: Model override (defaults: Groq -> llama-3.3-70b-versatile, Gemini -> gemini-1.5-flash)
LLM_MODEL=

# Backend server port (default: 8081)
SERVER_PORT=8081
